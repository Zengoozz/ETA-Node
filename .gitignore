# ===========================
# 🟢 Node.js / Express Ignore
# ===========================

# Dependencies
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
logs/*.log
pids
*.pid
*.seed
*.pid.lock

# Coverage reports
coverage
*.lcov

# OS system files
.DS_Store
Thumbs.db

# Build output
dist
build
out
tmp
temp
.cache
.nyc_output

# IDE / Editor configs
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Optional: Docker or CI related
docker-compose.override.yml
.docker/
.dockerignore

# Testing temp data
test-results/
jest-html-reporters-*.html

# ===========================
# Custom project folders
# ===========================

